[Unit]
Description=Sunsynk SQLite logger
After=network.target
Requires=dev-sunsynk.device
After=dev-sunsynk.device

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sunsynk-connect
ExecStart=/home/pi/sunsynk-connect/.venv/bin/python bin/logger.py \
    --port /dev/sunsynk \
    --db /home/pi/sunsynk.db \
    --interval 60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
