[Unit]
Description=Sunsynk automation rule engine
After=network.target sunsynk-logger.service
Requires=dev-sunsynk.device
After=dev-sunsynk.device

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sunsynk-connect
ExecStart=/home/pi/sunsynk-connect/.venv/bin/python bin/automate.py \
    --port /dev/sunsynk \
    --rules automation/rules.yaml \
    --interval 30
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
