# solar-rule-engine config
# Copy this file per installation and adjust values.

# --- Location ---
location:
  latitude: -27.7         # your GPS latitude
  longitude: 28.43        # your GPS longitude
  timezone: "Africa/Johannesburg"

# --- Solar panel array ---
panels:
  total_kwp: 5.5          # Total installed kWp (e.g. 10 × 550W = 5.5kWp)
  tilt: 26                # Degrees from horizontal
  azimuth: -5             # 0 = North (Southern Hemisphere), 90 = East, -90/270 = West

# --- Battery ---
battery:
  capacity_kwh: 14.4      # Usable battery capacity in kWh
  min_soc: 30             # Absolute floor — never command below this %
  max_soc: 100

# --- MQTT (local Mosquitto, bridged to Solar Assistant) ---
mqtt:
  host: "localhost"
  port: 1883
  username: ""            # leave empty if no auth
  password: ""
  inverter_id: "inverter_1"   # matches Solar Assistant topic prefix

# --- Weather source ---
# "mariadb" = read from local MariaDB (recommended — data from Ecowitt via webhook)
# "openmeteo" = use Open-Meteo forecast only (no station, simpler setup)
weather_source: "mariadb"

# --- Local MariaDB (weather station data written by weather_webhook) ---
mariadb:
  host: "localhost"
  port: 3306
  database: "wattcast"
  user: "wattcast"
  password: "CHANGE_ME"   # set to your DB password

# --- Switches ---
# Each entry is a Wi-Fi switch the engine can control.
# Supported types: shelly, http
# Supported roles: geyser, pool_pump, generic_load
#
switches:
  - name: geyser
    type: shelly
    ip: "192.168.1.x"         # replace with your Shelly IP
    gen: 2                    # 1 = Gen1 (Shelly 1/1PM/Plug), 2 = Gen2 (Shelly Plus/Pro)
    channel: 0
    username: ""
    password: "CHANGE_ME"     # your Shelly password
    role: geyser
    element_watts: 3000       # 3kW element
    min_soc_to_run: 50        # don't run geyser below this battery SOC %
    surplus_margin_watts: 300 # headroom above element_watts before turning on
    window_start_hour: 9      # earliest hour geyser may run (local time)
    window_end_hour: 16       # latest hour geyser may run
    min_on_minutes: 10        # minimum run time before allowing turn-off (protects element)
    max_daily_minutes: 180    # daily run budget (3 hours)
    min_off_minutes: 5        # minimum off time before allowing turn-on again

  # Uncomment and fill in for additional switches:
  # - name: pool_pump
  #   type: shelly
  #   ip: "192.168.1.y"
  #   gen: 2
  #   channel: 0
  #   role: pool_pump
  #   pump_watts: 750
  #   min_soc_to_run: 40
  #   window_start_hour: 10
  #   window_end_hour: 15
  #   min_on_minutes: 30
  #   max_daily_minutes: 240
  #   min_off_minutes: 10

  # - name: workshop_ac
  #   type: http
  #   url_on:  "http://192.168.1.z/cm?cmnd=Power%20On"   # Tasmota example
  #   url_off: "http://192.168.1.z/cm?cmnd=Power%20Off"
  #   url_status: "http://192.168.1.z/cm?cmnd=Power"
  #   status_on_value: "ON"
  #   role: generic_load
  #   load_watts: 1500
  #   min_soc_to_run: 60
  #   window_start_hour: 9
  #   window_end_hour: 17
  #   min_on_minutes: 15
  #   max_daily_minutes: 120
  #   min_off_minutes: 10
engine:
  eval_interval_seconds: 300      # How often to run the decision loop (5 min)
  forecast_refresh_minutes: 60    # How often to refresh Open-Meteo forecast
  hysteresis_minutes: 15          # Minimum time between same-topic changes
  dry_run: true                   # true = log commands only, do not publish to inverter
  log_level: "INFO"               # DEBUG, INFO, WARNING

# --- Thresholds (tune per site) ---
thresholds:
  # SOC targets that rules may command (within battery.min_soc / battery.max_soc)
  soc_target_rainy_day: 90        # Charge to this when bad forecast
  soc_target_good_day: 50         # Allow discharge to this when good forecast
  soc_target_default: 70

  # Grid charge current limits (Amps) - inverter-specific max
  grid_charge_max_a: 40    # Deye/Sunsynk max grid charge current
  grid_charge_min_a: 10
  grid_charge_off: 0

  # Forecast thresholds
  forecast_good_kwh: 15.0         # Expected daily yield above which it's a "good" day
  forecast_poor_kwh: 8.0          # Below which it's a "poor" day

  # Rain probability threshold
  rain_probability_high: 0.60     # 60% chance of rain = treat as rainy
