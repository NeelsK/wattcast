# WattCast Solar Rule Engine — Configuration
# Copy to config.yaml and adjust values for your installation.
# config.yaml is gitignored (contains passwords).

# ---------------------------------------------------------------------------
# Location
# ---------------------------------------------------------------------------
location:
  latitude: -27.7
  longitude: 28.43
  timezone: "Africa/Johannesburg"

# ---------------------------------------------------------------------------
# Solar panel array
# ---------------------------------------------------------------------------
panels:
  total_kwp: 5.5          # Total installed kWp
  tilt: 26                # Degrees from horizontal
  azimuth: -5             # 0 = North (Southern Hemisphere), 90 = East, -90/270 = West

# ---------------------------------------------------------------------------
# Battery
# ---------------------------------------------------------------------------
battery:
  capacity_kwh: 14.4      # Usable battery capacity in kWh
  min_soc: 40             # Absolute floor — never set capacity_point below this
  max_soc: 100

# ---------------------------------------------------------------------------
# MQTT (local Mosquitto, bridged to Solar Assistant)
# ---------------------------------------------------------------------------
mqtt:
  host: "localhost"
  port: 1883
  username: ""
  password: ""
  inverter_id: "inverter_1"

# ---------------------------------------------------------------------------
# Weather source
# "mariadb"   = read from local MariaDB (recommended)
# "openmeteo" = use Open-Meteo forecast only (no weather station)
# ---------------------------------------------------------------------------
weather_source: "mariadb"

# ---------------------------------------------------------------------------
# Local MariaDB
# ---------------------------------------------------------------------------
mariadb:
  host: "localhost"
  port: 3306
  database: "wattcast"
  user: "wattcast"
  password: "CHANGE_ME"

# ---------------------------------------------------------------------------
# Engine behaviour
# ---------------------------------------------------------------------------
engine:
  eval_interval_seconds: 300       # How often to run the rule evaluation (5 min)
  forecast_refresh_minutes: 60     # How often to refresh Open-Meteo forecast
  preset_cooldown_minutes: 30      # Minimum time between preset switches
  dry_run: true                    # true = evaluate only, NOT sent to inverter
  log_level: "INFO"

# ---------------------------------------------------------------------------
# PRESETS
#
# Each preset defines exactly 6 TOU time slots.
# Unused slots repeat the last active slot's time with grid_charge: false.
#
# Per slot:
#   time:        "HH:MM"  — slot start time
#   capacity:    int      — SOC discharge floor % (min 40%)
#   grid_charge: bool     — grid charging enabled for this slot
# ---------------------------------------------------------------------------
presets:

  # Default — balanced winter day
  # Overnight draws ~15% SOC (300W load, 00:00–07:00).
  # Solar peaks 11:00–14:00. Battery full by ~14:00.
  default:
    description: "Balanced winter — protects overnight, frees up during solar hours"
    slots:
      - time: "00:00"
        capacity: 55
        grid_charge: true
        # overnight floor — 55% covers ~15% draw to 07:00 with buffer above 40%
      - time: "07:00"
        capacity: 40
        grid_charge: true
        # solar ramping — allow discharge, PV will recover
      - time: "13:00"
        capacity: 40
        grid_charge: true
        # peak surplus window — floor irrelevant, battery charging hard
      - time: "18:00"
        capacity: 60
        grid_charge: true
        # evening — no solar, protect enough for overnight
      - time: "18:00"
        capacity: 60
        grid_charge: false
        # disabled
      - time: "18:00"
        capacity: 60
        grid_charge: false
        # disabled

  # Summer good — excellent forecast (>15 kWh tomorrow, <30% rain)
  summer_good:
    description: "Good solar day — low floors, let solar fill the battery"
    slots:
      - time: "00:00"
        capacity: 40
        grid_charge: true
      - time: "07:00"
        capacity: 40
        grid_charge: true
      - time: "13:00"
        capacity: 40
        grid_charge: true
      - time: "18:00"
        capacity: 50
        grid_charge: true
      - time: "18:00"
        capacity: 50
        grid_charge: false
      - time: "18:00"
        capacity: 50
        grid_charge: false

  # Winter mixed — moderate forecast (5–15 kWh tomorrow)
  winter_mixed:
    description: "Mixed forecast — moderate protection, allow solar to contribute"
    slots:
      - time: "00:00"
        capacity: 60
        grid_charge: true
      - time: "07:00"
        capacity: 50
        grid_charge: true
      - time: "13:00"
        capacity: 40
        grid_charge: true
      - time: "18:00"
        capacity: 65
        grid_charge: true
      - time: "18:00"
        capacity: 65
        grid_charge: false
      - time: "18:00"
        capacity: 65
        grid_charge: false

  # Storm protection — poor forecast (<5 kWh) or active rain
  storm_protection:
    description: "Poor forecast or active rain — protect battery, grid charge to fill"
    slots:
      - time: "00:00"
        capacity: 70
        grid_charge: true
      - time: "07:00"
        capacity: 60
        grid_charge: true
      - time: "13:00"
        capacity: 55
        grid_charge: true
      - time: "18:00"
        capacity: 75
        grid_charge: true
      - time: "18:00"
        capacity: 75
        grid_charge: false
      - time: "18:00"
        capacity: 75
        grid_charge: false

# ---------------------------------------------------------------------------
# RULES
#
# Evaluated in ascending priority order (lower number = higher priority).
# First matching rule wins — its preset is applied.
#
# Condition structure:
#   conditions:
#     any:              # groups are OR'd together
#       - all:          # conditions within a group are AND'd
#           - field: <name>
#             op: ">" | "<" | ">=" | "<=" | "==" | "!="
#             value: <number>
#
# Available fields:
#   battery_soc                  — % (0–100)
#   pv_power                     — W
#   load_power                   — W
#   net_surplus                  — W (pv - load)
#   rain_rate                    — mm/h
#   rain_probability_tomorrow    — % (0–100)
#   forecast_tomorrow_kwh        — kWh
#   forecast_today_remaining_kwh — kWh
#   irradiance                   — W/m²
#   irradiance_avg_15min         — W/m² (15-min rolling average)
#   cloud_cover_now              — % (0–100)
#   loadshedding_active          — 1 or 0  [stub]
#   loadshedding_next_hours      — hours   [stub]
#   hour                         — 0–23
# ---------------------------------------------------------------------------
rules:

  - name: "Storm Protection"
    priority: 10
    preset: storm_protection
    description: "Active rain or very poor forecast tomorrow"
    conditions:
      any:
        - all:
            - field: rain_rate
              op: ">"
              value: 2.0
        - all:
            - field: rain_probability_tomorrow
              op: ">"
              value: 70
            - field: forecast_tomorrow_kwh
              op: "<"
              value: 5.0

  - name: "Good Solar Day"
    priority: 20
    preset: summer_good
    description: "Tomorrow forecast excellent, low rain risk"
    conditions:
      any:
        - all:
            - field: forecast_tomorrow_kwh
              op: ">"
              value: 8.5
            - field: rain_probability_tomorrow
              op: "<"
              value: 30
              # 8.5 kWh raw ≈ 15 kWh actual (Open-Meteo underestimates by ~1.8x)

  - name: "Mixed Day"
    priority: 30
    preset: winter_mixed
    description: "Moderate forecast — some solar expected"
    conditions:
      any:
        - all:
            - field: forecast_tomorrow_kwh
              op: ">="
              value: 3.0
            - field: forecast_tomorrow_kwh
              op: "<"
              value: 8.5
              # 3.0–8.5 kWh raw ≈ 5–15 kWh actual

  - name: "Default"
    priority: 999
    preset: default
    default: true
    description: "Fallback when no other rule matches"
    conditions:
      any: []
